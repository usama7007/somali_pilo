---
import "../styles/global.css";

const {
  title = "Qudhac Philosophy",
  description = "Joornaal fudud oo loogu talagalay maqaallo falsafadeed oo ka baxa nolosha Soomaalida iyo dhaqanka falsafadeed ee dunida."
} = Astro.props;
---

<!doctype html>
<html lang="so">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content={description}>
    <link rel="icon" href="/logo3-small.png" type="image/png">
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Bogga hore ee Qudhac Philosophy">
        <span class="brand-mark">
          <img src="/logo3-small.png" alt="">
        </span>
        <span>
          <strong>Qudhac Philosophy</strong>
          <small>Xididdo qoto dheer, una furan waxa cusub</small>
        </span>
      </a>
      <nav aria-label="Socodka bogga">
        <a href="/articles/">Maqaallo</a>
        <a href="/#submit">Dir maqaal</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <p>Qudhac Philosophy - joornaal fudud oo loogu talagalay fikir taxaddar leh.</p>
      <a href="#top">Kor ugu noqo</a>
    </footer>
  </body>
</html>
