---
import "../styles/global.css";

const {
  title = "Somali Philosophy",
  description = "A light digital journal for essays on Somali thought, ethics, language, society, and the wider philosophical tradition."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content={description}>
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Somali Philosophy home">
        <span class="brand-mark">SP</span>
        <span>
          <strong>Somali Philosophy</strong>
          <small>Falsafad, fikir, iyo nolol</small>
        </span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="/articles/">Articles</a>
        <a href="/#submit">Submit</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <p>Somali Philosophy - A light static journal for careful thought.</p>
      <a href="#top">Back to top</a>
    </footer>
  </body>
</html>
