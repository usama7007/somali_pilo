---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const articles = (await getCollection("articles"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latestArticles = articles.slice(0, 6);
---

<BaseLayout>
  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="kicker">Joornaal deggan oo fikir qoto dheer leh</p>
        <h1 id="hero-title">Qudhac Philosophy</h1>
        <p>
          Xididdo qoto dheer, una furan waxa cusub. Maqaallo falsafadeed iyo qoraallo ka baxa
          nolosha Soomaalida iyo dhaqanka falsafadeed ee dunida.
        </p>
        <div class="hero-actions" aria-label="Falalka muhiimka ah">
          <a class="button primary" href="/articles/">Akhri maqaallada</a>
          <a class="button secondary" href="#submit">Dir maqaal</a>
        </div>
      </div>
      <aside class="editor-note" aria-label="Qoraalka tifaftiraha">
        <img src="/assets-reading-room.svg" alt="Buugaag iyo qoraallo miis akhris saaran">
        <span>Qoraalka tifaftiraha</span>
        <p>
          Waxaan daabacnaa qoraallo si taxaddar leh loo diyaariyey, si fikrad walba u hesho meel ay ku neefsato.
        </p>
      </aside>
    </section>

    <section class="section articles-section" id="articles" aria-labelledby="articles-title">
      <div class="section-heading">
        <div>
          <p class="kicker">Qoraalladii ugu dambeeyay</p>
          <h2 id="articles-title">Maqaallo</h2>
        </div>
        <a class="read-link" href="/articles/">Eeg dhammaan maqaallada</a>
      </div>

      <div class="article-list">
        {latestArticles.map((article, index) => (
          <article class:list={["article-card", { featured: index === 0 }]}>
            <div>
              <p class="article-meta">{article.data.topic} - {article.data.readingTime} - {article.data.language}</p>
              <h3><a href={`/articles/${article.slug}/`}>{article.data.title}</a></h3>
              <p>{article.data.description}</p>
            </div>
            <a class="read-link" href={`/articles/${article.slug}/`}>Akhri</a>
          </article>
        ))}
      </div>
    </section>

    <section class="submit-section" id="submit" aria-labelledby="submit-title">
      <div>
        <p class="kicker">Ka qayb qaado</p>
        <h2 id="submit-title">Soo dir maqaal, milicsi, ama soo-jeedin turjumaad.</h2>
      </div>
      <p>
        Qoraallada waxaad noogu soo diri kartaa email. Waxaan akhrinnaa, tifaftirnaa, kadibna annaga ayaa
        go'aansanna waxa la daabacayo.
      </p>
      <a class="button primary" href="mailto:somali.philo@gmail.com?subject=Qudhac%20Philosophy%20Submission">
        somali.philo@gmail.com
      </a>
    </section>
  </main>
</BaseLayout>
