---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const articles = (await getCollection("articles"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Maqaallo - Qudhac Philosophy">
  <main id="top">
    <section class="page-hero">
      <p class="kicker">Kaydka qoraallada</p>
      <h1>Maqaallo</h1>
      <p>
        Qoraal walba wuxuu leeyahay bog u gaar ah, si akhrisku u noqdo degdeg, nadiif ah, oo fudud.
      </p>
    </section>

    <section class="section archive-layout" aria-label="Kaydka maqaallada">
      <div class="archive-list">
        {articles.map((article) => (
          <article class="archive-item">
            <p class="article-meta">{article.data.topic} - {article.data.readingTime} - {article.data.language}</p>
            <h2><a href={`/articles/${article.slug}/`}>{article.data.title}</a></h2>
            <p>{article.data.description}</p>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
