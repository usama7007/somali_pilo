---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const articles = (await getCollection("articles"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Articles - Somali Philosophy">
  <main id="top">
    <section class="page-hero">
      <p class="kicker">Archive</p>
      <h1>Articles</h1>
      <p>
        Every essay is stored as its own Markdown file, then Astro turns it into a fast static page.
      </p>
    </section>

    <section class="section archive-layout" aria-label="Article archive">
      <div class="archive-list">
        {articles.map((article) => (
          <article class="archive-item">
            <p class="article-meta">{article.data.topic} - {article.data.readingTime} - {article.data.language}</p>
            <h2><a href={`/articles/${article.slug}/`}>{article.data.title}</a></h2>
            <p>{article.data.description}</p>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
